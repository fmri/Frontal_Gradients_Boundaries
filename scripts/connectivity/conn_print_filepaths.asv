%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% The purpose of this script is to print to command window the paths to
%%% T1, functional, and annotation files so they can be easily copy/pasted
%%% into conn toolbox in the correct subject order
%%%
%%% Tom Possidente - June 2026
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

addpath(genpath('/projectnb/somerslab/tom/functions/'));
ccc;

%% 
subjCodes = {'MK','AB', 'AD','LA','AE','TP','NM','AF','AG','AI','GG','UV','KQ','LN','PT','NS','SL'};
% LA has 2 rs runs and 1 is rejected for motion (keep)
% AG has 3 rs runs and 2 are rejected for motion (keep)
% NS has 1 rs run (keep)
% PQ has 3 rs runs and all are rejected for motion (reject)
% PL has 3 rs runs and 2 are rejected for motion (reject)
% RT has 0 rs runs (reject)
N = length(subjCodes);

%% Set key variabels
T1_label_dir = '/projectnb/somerslab/tom/projects/sensory_networks_FC/data/recons/';
func_dir = '/projectnb/somerslab/tom/projects/sensory_networks_FC/data/unpacked_data_nii/';

%% Display T1s
for ss = 1:N
    fpath = [T1_label_dir subjCodes{ss} '/mri/T1.mgz'];
    assert(isfile(fpath))
    disp(fpath)
end
disp(' ') % whitespace

%% Display rs functionals
N_runs_all = nan(N,1);
for ss = 1:N
    rundir = dir([func_dir subjCodeDates{ss}]);
    rundir_names = {rundir.name};
    rundir_name_inds = startsWith(rundir_names, '0');
    rundir_names = rundir_names(rundir_name_inds);
    N_runs = length(rundir_names);
    N_runs_all(ss) = N_runs;
    %disp(N_runs)
    for rr = 1:N_runs
        fpath = [func_dir subjCodeDates{ss} '/' rundir_names{rr} '/auf_topupApplied.nii'];
        assert(isfile(fpath))
        disp(fpath)
    end
end
disp(' ') % whitespace

%% Display ROI files
for ss = 1:N
    fpath = [T1_label_dir subjCodes{ss} '/label/' subjCodes{ss} '_IPS_V12_TPJ_fsaverage.surf.nii'];
    assert(isfile(fpath))
    disp(fpath)
end
disp(' ') % whitespace


